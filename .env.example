# ─── LLM / AI Assistant Configuration ───────────────────────────────────────
#
# Supported providers:
#   none    → Structured alerts + extractive corpus text only (no network calls)
#   gemini  → Google Gemini API (free tier available at https://aistudio.google.com/app/apikey)
#   local   → Any OpenAI-compatible local server (Ollama, LM Studio, etc.)
#   api     → Any OpenAI-compatible remote API

LLM_PROVIDER=gemini

# For Gemini: get a free key at https://aistudio.google.com/app/apikey
# Then set: LLM_PROVIDER=gemini  LLM_API_KEY=AIza...
LLM_MODEL=gemini-1.5-flash

# For local/api providers only (leave blank for gemini)
LLM_BASE_URL=

# Your API key (Gemini key, OpenAI key, etc.)
LLM_API_KEY=your-api-key-here

# ─── Sentinel-2 Embedding Model ──────────────────────────────────────────────
# Set to 'transformer' to use sentence-transformers for semantic search in the RAG corpus.
# Requires: pip install sentence-transformers  and model cached on disk.
# Default (unset): fast hash-based token overlap search (no extra dependencies).
AQUAWATCH_EMBED=

# ─── Path Override ────────────────────────────────────────────────────────────
# Override the repo root for data/, config/, models/ paths
AQUAWATCH_ROOT=

# ─── PostgreSQL (persistent application data) ────────────────────────────────
# Leave DATABASE_URL empty to run exactly as before (analyses are not persisted).
# Local: `docker compose up -d db` reads the POSTGRES_* values below.
# Hosted (Render/Neon/Supabase): paste the provider's URL; postgres:// is accepted.
POSTGRES_USER=aquasafe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aquasafe
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aquasafe:change-me@127.0.0.1:5432/aquasafe

# Where field-submission images are stored locally (default: data/uploads)
AQUASAFE_UPLOADS_DIR=
